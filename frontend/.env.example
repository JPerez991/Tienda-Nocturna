# ---------------------------------------------------------------------------
# Variables del FRONTEND (se incrustan en el bundle: NUNCA pongas secretos aquí;
# las claves de Wompi, la base de datos y el JWT viven solo en el BACKEND).
# ---------------------------------------------------------------------------

# URL base de la API.
# En desarrollo NO hace falta: vite proxya /api y /health a localhost:8080.
# En producción SE DEJA VACÍA a propósito: vercel.json reescribe /api/* hacia
# el backend, así el navegador ve todo como mismo origen y la cookie httpOnly
# `token` (SameSite=Lax) sigue funcionando. Si la llenas, el login se rompe en
# Safari/iOS porque la cookie pasaría a ser de terceros.
# VITE_API_URL=

# Número de WhatsApp en formato internacional, sin «+» ni espacios.
# Por defecto: 573113919437 (311 391 9437).
# VITE_WHATSAPP_NUMERO=573113919437
