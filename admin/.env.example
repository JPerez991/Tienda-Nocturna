# ---------------------------------------------------------------------------
# Variables del PANEL (se incrustan en el bundle: sin secretos).
# ---------------------------------------------------------------------------

# URL pública de la tienda, para el enlace "Ver la tienda".
# En local: http://localhost:5173 · En producción: https://tudominio.com
# VITE_STORE_URL=http://localhost:5173

# URL base de la API. Se deja VACÍA a propósito: /api se proxya (Vite en dev,
# rewrite en Vercel) para que la cookie de sesión sea mismo origen.
# VITE_API_URL=
