# --- Base de datos ---
DATABASE_URL="postgresql://user:pass@localhost:5432/nocturna?schema=public"

# --- Seguridad ---
# Contraseña mínima 32 chars. Genera una con: openssl rand -base64 32
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
# Solo acepta "true" o "false" (cualquier otro valor aborta el arranque).
# En producción debe ser true (usa https); en local, false.
COOKIE_SECURE="false"
# Origen permitido del frontend (whitelist de CORS) y base del redirect de Wompi.
# IMPORTANTE: el WAF de Wompi devuelve 403 si el redirect-url contiene
# "localhost" o "127.0.0.1". En local usa el loopback IPv6 (Vite lo sirve igual):
#   CORS_ORIGIN="http://[::1]:5173"
# En producción: el dominio real (https://tienda.com).
CORS_ORIGIN="http://localhost:5173"

# --- Pasarela de pago Wompi ---
# Llave PÚBLICA (va en frontend, no es secreta)
WOMPI_PUBLIC_KEY="pub_test_..."
# Llave PRIVADA (solo backend, NUNCA en el frontend ni en git)
WOMPI_PRIVATE_KEY="priv_test_..."
# Secreto para verificar la firma de los webhooks (prefijo sandbox: test_events_...)
WOMPI_WEBHOOK_SECRET="test_events_..."
# Secreto de INTEGRIDAD: firma del checkout (prefijo sandbox: test_integrity_...)
# Protege referencia+monto+moneda; NUNCA va en el frontend.
WOMPI_INTEGRITY_KEY="test_integrity_..."
# Entorno de pruebas o producción
WOMPI_ENV="sandbox"

# --- Login de Google para el panel admin (OPCIONAL) ---
# Si falta CUALQUIERA de estas variables, las rutas OAuth responden
# 503 (API) o redirigen a /login?error=not_configured (navegador).
# 1) Google Cloud Console → Credenciales → ID de cliente OAuth 2.0 → "Aplicación web".
# 2) En "URIs de redireccionamiento autorizados" agrega EXACTAMENTE el valor
#    de GOOGLE_REDIRECT_URI (en local: http://localhost:8080/api/auth/google/callback).
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8080/api/auth/google/callback"
# Origen del panel (sin barra final). Por defecto http://localhost:5174.
ADMIN_URL="http://localhost:5174"
# SOLO estos correos pueden entrar al panel con Google (separados por comas).
# Comparación sin distinción de mayúsculas. Vacío = nadie autorizado.
ADMIN_GOOGLE_EMAILS="admin@tienda.com,otro-admin@tienda.com"

# --- Servidor ---
PORT="8080"
NODE_ENV="development"
