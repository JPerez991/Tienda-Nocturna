# --- Base de datos ---
DATABASE_URL="postgresql://user:pass@localhost:5432/nocturna?schema=public"

# --- Seguridad ---
# Contraseña mínima 32 chars. Genera una con: openssl rand -base64 32
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
# En producción debe ser true (usa https)
COOKIE_SECURE="false"
# Origen permitido del frontend (whitelist de CORS)
CORS_ORIGIN="http://localhost:5173"

# --- Pasarela de pago Wompi ---
# Llave PÚBLICA (va en frontend, no es secreta)
WOMPI_PUBLIC_KEY="pub_test_..."
# Llave PRIVADA (solo backend, NUNCA en el frontend ni en git)
WOMPI_PRIVATE_KEY="priv_test_..."
# Secreto para verificar la firma de los webhooks
WOMPI_WEBHOOK_SECRET="whsec_..."
# Entorno de pruebas o producción
WOMPI_ENV="sandbox"

# --- Servidor ---
PORT="8080"
NODE_ENV="development"
